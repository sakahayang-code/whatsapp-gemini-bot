# ================================================================
# KONFIGURASI BOT WHATSAPP AI - GEMINI 3.8 FLASH HIGH
# ================================================================

# 1. GOOGLE GEMINI API KEY (Dapatkan gratis di https://aistudio.google.com/)
# Anda bisa memasukkan lebih dari satu key dipisahkan koma untuk failover otomatis:
# Contoh: GEMINI_API_KEY=AIzaSyA...,AIzaSyB...
GEMINI_API_KEY=

# 2. MODEL GEMINI
# Model yang diminta: gemini-3.8-flash-high
# (Bot memiliki fitur auto-fallback ke gemini-2.0-flash / gemini-1.5-flash jika model sedang tidak tersedia di API)
GEMINI_MODEL=gemini-3.8-flash-high
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=2048
MAX_HISTORY_LENGTH=20

# 3. IDENTITAS & PENGATURAN BOT
BOT_NAME="Gemini 3.8 Flash AI"
BOT_PREFIX="."
# Nomor WhatsApp Owner (tanpa tanda + atau spasi, misal 6281234567890)
OWNER_NUMBER=6281234567890

# 4. METODE PENAUTAN / KONEKSI (PAIRING)
# Pilihan A: Gunakan QR Code di terminal -> Biarkan USE_PAIRING_CODE=false
# Pilihan B: Gunakan 8-digit Pairing Code -> Set USE_PAIRING_CODE=true dan isi PAIRING_NUMBER
USE_PAIRING_CODE=false
PAIRING_NUMBER=6281234567890

# 5. PERILAKU CHAT
# Balas otomatis di chat pribadi (DM) tanpa harus mengetik .ai
DM_AUTO_REPLY=true
# Mode di grup: 'mention' (hanya jika di-tag / di-reply), 'all' (semua chat jika AI ON), 'prefix' (hanya perintah)
GROUP_REPLY_MODE=mention

# 6. METADATA STIKER
STICKER_PACK="Gemini AI Bot"
STICKER_AUTHOR="Google Gemini"
